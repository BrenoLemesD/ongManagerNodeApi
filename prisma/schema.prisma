generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  password           String
  phone              String?
  role               String               @default("user")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ongs               UserOng[]
  tasksCreated       KanbanTask[]         @relation("TasksCreated")
  tasksAssigned      KanbanTask[]         @relation("TasksAssigned")
  taskHistoryActions TaskHistory[]        @relation("TaskHistoryActor")
  resetTokens        PasswordResetToken[]
  eventsCreated      Event[]              @relation("EventsCreated")
}

model Ong {
  id                    String              @id @default(cuid())
  name                  String
  cnpj                  String?
  description           String?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  members               UserOng[]
  tasks                 KanbanTask[]
  financialTransactions Financial[]
  invites               OngInviteToken[]
  events                Event[]
}

model OngInviteToken {
  id        String    @id @default(cuid())
  ongId     String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  ong       Ong       @relation(fields: [ongId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserOng {
  id                    String      @id @default(cuid())
  userId                String
  ongId                 String
  role                  String      @default("member") // "admin" | "finance_manager" | "member"
  active                Boolean     @default(true)
  createdAt             DateTime    @default(now())
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ong                   Ong         @relation(fields: [ongId], references: [id], onDelete: Cascade)
  financialTransactions Financial[] @relation("CreatedBy")

  @@unique([userId, ongId])
}

model KanbanTask {
  id           String        @id @default(cuid())
  title        String
  description  String?
  priority     String        @default("media") // baixa, media, alta, urgente
  status       String        @default("a_fazer") // a_fazer, em_andamento, aguardando_aprovacao, concluido
  deadline     DateTime?
  ongId        String
  createdById  String
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ong          Ong           @relation(fields: [ongId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("TasksCreated", fields: [createdById], references: [id])
  assignedTo   User?         @relation("TasksAssigned", fields: [assignedToId], references: [id])
  history      TaskHistory[]
}

model TaskHistory {
  id             String     @id @default(cuid())
  taskId         String
  actorUserId    String?
  action         String
  previousStatus String?
  newStatus      String?
  createdAt      DateTime   @default(now())
  task           KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor          User?      @relation("TaskHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Financial {
  id          String   @id @default(cuid())
  ongId       String
  type        String // "receita" | "despesa"
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String // ex: "salario", "aluguel", "doacao", "outro"
  date        DateTime
  createdById String
  status      String   @default("confirmado") // "pendente" | "confirmado"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ong         Ong      @relation(fields: [ongId], references: [id], onDelete: Cascade)
  createdBy   UserOng  @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([ongId, date])
  @@index([ongId, createdAt])
}

model Event {
  id          String       @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  maxTickets  Int
  status          String       @default("ativo") // "ativo" | "encerrado" | "cancelado"
  inviteToken     String       @unique
  hasLandingPage  Boolean      @default(false)
  landingTemplate String?      @default("modern") // "modern" | "warm" | "minimal"
  primaryColor    String?      @default("#7c3aed")
  bannerUrl       String?
  ctaText         String?      @default("Garantir meu Ingresso")
  ongId           String
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ong             Ong          @relation(fields: [ongId], references: [id], onDelete: Cascade)
  createdBy       User         @relation("EventsCreated", fields: [createdById], references: [id])
  guests          EventGuest[]

  @@index([ongId, date])
  @@index([ongId, status])
}

model EventGuest {
  id         String   @id @default(cuid())
  eventId    String
  name       String
  email      String
  phone      String?
  ticketCode String   @unique
  status     String   @default("confirmado") // "confirmado" | "presente" | "cancelado"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId, status])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   @default("register_ong")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}
